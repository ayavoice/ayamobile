{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@aya/shared": ["./packages/shared/src/index.ts"],
      "@aya/automator": ["./modules/aya-automator/index.ts"],
      "@aya/automator/*": ["./modules/aya-automator/*"]
    }
  },
  "include": [
